#!/usr/bin/env bash
# Reference ./dev for a project that works with LanProjectsControlPanel (lpcp).
#
#   ./dev up                        ports published on 127.0.0.1: this machine only (always the default)
#   ./dev up --bind=127.0.0.3       the same ports, published on 127.0.0.3 instead (what lpcp calls)
#   ./dev up --lan                  the same ports on every address (0.0.0.0), for phones and tablets
#   ./dev up --host=example.loc     answer to example.loc (combines with the above); reachable at
#                                   http://example.loc once /etc/hosts points it at the address it's on
#   ./dev down | logs
#
# --bind and --lan are mutually exclusive. Copy the option parsing below into the project's existing
# ./dev; don't replace what it already does.
set -euo pipefail
cd "$(dirname "$0")"

cmd="${1:-}"
shift || true

bind="" lan="" host=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --bind=*) bind="${1#--bind=}"; [[ -n "$bind" ]] || { echo "--bind needs an address" >&2; exit 2; }; shift ;;
    --bind)   bind="${2:?--bind needs an address}"; shift 2 ;;
    --host=*) host="${1#--host=}"; [[ -n "$host" ]] || { echo "--host needs a name" >&2; exit 2; }; shift ;;
    --host)   host="${2:?--host needs a name}"; shift 2 ;;
    --lan)    lan=1; shift ;;
    *) break ;;
  esac
done
if [[ -n "$bind" && -n "$lan" ]]; then
  echo "--bind and --lan can't be used together" >&2
  exit 2
fi
# Where: compose.yaml publishes the web port on ${BIND:-127.0.0.1}, so no option = this machine only.
if [[ -n "$bind" ]]; then export BIND="$bind"; elif [[ -n "$lan" ]]; then export BIND=0.0.0.0; fi
# Private ports (the database) on ${PRIVATE_BIND:-127.0.0.1}: they follow --bind to another loopback address
# (so two projects' databases don't collide), but never onto the network (--lan, or --bind to a LAN address).
if [[ "$bind" == 127.* ]]; then export PRIVATE_BIND="$bind"; fi
# Which name: compose.yaml serves ${SITE_HOST:-localhost}.
if [[ -n "$host" ]]; then export SITE_HOST="$host"; fi
if [[ ( "$host" == localhost || "$host" == *.localhost ) && -n "$bind" && "$bind" != 127.0.0.1 ]]; then
  echo "--host $host always resolves to 127.0.0.1, so it can't reach $bind: use another name (and a hosts entry)" >&2
  exit 2
fi

case "$cmd" in
  up)
    docker compose up -d --wait
    echo "http://${host:-${bind:-127.0.0.1}}/  (listening on ${BIND:-127.0.0.1})"
    if [[ -n "$host" && "$host" != localhost && "$host" != *.localhost ]]; then
      if [[ -n "$lan" ]]; then
        echo "other devices need a hosts entry (or DNS): <this machine's LAN address> $host"
      else
        echo "needs a hosts entry: ${bind:-127.0.0.1} $host   (in /etc/hosts)"
      fi
    fi
    ;;
  down) docker compose stop ;;
  logs) exec docker compose logs -f "$@" ;;
  *)    echo "usage: ./dev up [--bind=IP | --lan] [--host=NAME] | down | logs" >&2; exit 2 ;;
esac
